includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
    level: 6
    tmpDir: var/cache/phpstan
    scanDirectories:
        - vendor/codeigniter4/framework/app/Config
    scanFiles:
        - vendor/codeigniter4/framework/system/Common.php
    paths:
        - openapi
        - src
        - tests
        - scripts
