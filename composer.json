{
    "name": "johnnickell/fight-access-control",
    "description": "Framework-neutral identity, credential, session, authorization, and account-lifecycle contracts",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.5",
        "johnnickell/fight-common": "^1.4",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.4",
        "slevomat/coding-standard": "^8.27",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15.3",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/process": "^7.0",
        "yiisoft/di": "^1.4.1",
        "yiisoft/injector": "^1.2.2",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/router": "^4.0.2",
        "yiisoft/router-fastroute": "^4.0.3",
        "zircote/swagger-php": "^6.5"
    },
    "autoload": {
        "psr-4": {
            "Fight\\AccessControl\\Domain\\": "src/Domain",
            "Fight\\AccessControl\\Application\\": "src/Application",
            "Fight\\AccessControl\\Adapter\\": "src/Adapter"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fight\\Test\\AccessControl\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        },
        "platform": {
            "php": "8.5.4"
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "suggest": {
        "slim/slim": "Enable the optional Slim permission target integration (^4.15.3).",
        "yiisoft/router": "Enable the optional Yii 3 permission target integration (^4.0.2).",
        "zircote/swagger-php": "Generate a consumer-owned OpenAPI document from the opt-in openapi/ component catalog."
    }
}
