#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd -P)"
cd "$ROOT_DIR"
if [[ -f scripts/planning_portfolio.php ]]; then
    source ./bin/.planning-runtime
    run_planning planning_portfolio.php --write "$@"
elif [[ -d planning ]]; then
    echo 'Planning authority exists without scripts/planning_portfolio.php.' >&2
    exit 1
else
    echo 'Planning authority is not established yet; bootstrap integrity is unchanged.'
fi
