#!/usr/bin/env bash
set -eo pipefail
cd "$(dirname "$0")/.."
root=$(pwd -P)
config="$root/etc/local-tooling.json"

incomplete() { printf 'Build incomplete: %s\n' "$*" >&2; exit 1; }
hold() { incomplete "$@"; }
source "$root/bin/.host-deadline"

for arg in "$@"; do
    if [[ "$arg" != --force ]]; then
        jq -e --arg arg "$arg" '(.build_options // []) | index($arg) != null' "$config" >/dev/null ||
            incomplete 'Usage: ./bin/build [--force]'
    fi
done

# All Git and Docker effects stay on the host. The supplied PHP environment
# owns the checkout lock, fingerprint, and evidence; it sees no Docker socket.
DOCKER_BIN=${DOCKER_BIN:-docker}
image=${FIGHT_ACCESS_CONTROL_PLANNING_IMAGE:-fight-access-control-php}
PHP_IMAGE=$("$DOCKER_BIN" image inspect --format '{{.Id}}' "$image") ||
    incomplete 'Planning tooling image unavailable. Prepare it with ./bin/up --build-only (main), or select a prepared package image with FIGHT_ACCESS_CONTROL_PLANNING_IMAGE.'

command_from_config() {
    local rows row
    rows=$(jq -c --arg key "$1" '(.[$key] // [])[] | @json' "$config")
    command=()
    if [[ -n "$rows" ]]; then
        while IFS= read -r row; do command+=("$(jq -r 'fromjson' <<< "$row")"); done <<< "$rows"
    fi
}

tracked_inputs() {
    local rows row path snapshot paths=(var)
    if rows=$(jq -c '(.outputs // [])[] | @json' "$config"); then
        if [[ -n "$rows" ]]; then
            while IFS= read -r row; do
                path=$(jq -r 'fromjson' <<< "$row") || { printf 'null\n'; return; }
                paths+=("$path")
            done <<< "$rows"
        fi
        if snapshot=$(bounded 1800 git ls-files -z -- "${paths[@]}" | jq -Rsc 'split("\u0000")'); then
            printf '%s\n' "$snapshot"
            return
        fi
    fi
    printf 'null\n'
}

umask 077
pipes=$(mktemp -d)
trap '
    if [[ -s "$pipes/worker.err" ]]; then head -c 65536 "$pipes/worker.err" >&2 || :; fi
    rm -f -- "$pipes/request" "$pipes/reply" "$pipes/worker.err" "$pipes/worker.cid"; rmdir -- "$pipes"
' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
mkfifo "$pipes/request" "$pipes/reply"
mount=${root//\"/\"\"}
# Keep the transport in its own host group, with no caller output pipe.
# Even a transport that cannot be reaped must not delay the caller's EOF.
set -m
"$DOCKER_BIN" container run -i --rm --pull=never --network=none --read-only --label com.docker.compose.project= \
    --cidfile "$pipes/worker.cid" --cap-drop ALL --security-opt no-new-privileges \
    --mount "type=bind,\"source=$mount\",\"target=$mount\"" --workdir "$root" \
    --user "$(id -u):$(id -g)" --env HOME=/tmp --entrypoint php \
    "$PHP_IMAGE" -n scripts/build_cache.php "$@" < "$pipes/request" > "$pipes/reply" 2> "$pipes/worker.err" &
worker=$!
set +m
exec 7> "$pipes/request" 8< "$pipes/reply"

# The protocol admits only fixed transitions, never worker-supplied commands.
receive() { IFS= read -r reply <&8 || return; }
send() { printf '%s\n' "$1" >&7; }
finish() {
    local worker_status=0
    exec 7>&- 8<&-
    wait "$worker" || worker_status=$?
    cat "$pipes/worker.err" >&2 || :
    rm -f -- "$pipes/worker.err"
    exit "$worker_status"
}
worker_group_stopped() {
    local polls="$1"
    while kill -0 -- "-$worker" 2>/dev/null; do
        (( polls > 0 )) || return 1
        polls=$((polls - 1))
        sleep 0.1
    done
    wait "$worker" 2>/dev/null || :
}
stop_phase_worker() {
    local outcome='exited after EOF request' container=''
    # Read the ID before Docker has a chance to remove its cidfile on exit.
    if [[ -f "$pipes/worker.cid" ]]; then IFS= read -r container < "$pipes/worker.cid" || :; fi
    [[ "$container" =~ ^[0-9a-f]{64}$ ]] || container='unknown ID'
    exec 7>&- 8<&-
    if ! worker_group_stopped 20; then
        # Kill only the host transport group; do not proxy TERM to Docker
        # or infer the container stopped when the client disconnects.
        kill -KILL -- "-$worker" 2>/dev/null || :
        outcome='exited after host KILL request'
        worker_group_stopped 10 || outcome='shutdown not confirmed after host KILL request'
    fi
    printf 'Evidence worker group %s: %s (container %s).\n' "$worker" "$outcome" "$container" >&2
    printf 'Reobserve the exact worker, Docker runtime and build lock (%s) before retrying.\n' "$root/var/build.lock" >&2
}
run_phase() {
    local status=0
    bounded 1800 "$@" 7>&- 8<&- || status=$?
    (( status != 0 )) || return 0
    if (( status == 124 )); then
        printf 'Build incomplete: Command timed out: %s\n' "${*:1:3}" >&2
    else
        printf 'Build incomplete: Command failed (exit %s): %s\n' "$status" "${*:1:3}" >&2
    fi
    stop_phase_worker
    exit 1
}
receive || finish
[[ "$reply" == PLAN ]] || incomplete 'Unexpected planning protocol state'
run_phase "$root/bin/planning-check"
tracked=$(tracked_inputs)
send "$tracked"
receive || finish
rechecked=no
if [[ "$reply" == RECHECK ]]; then
    tracked=$(tracked_inputs)
    send "$tracked"
    rechecked=yes
    receive || finish
fi
case "$reply" in
    'HIT '*)
        [[ "$rechecked" == yes ]] || incomplete 'Cache hit without fresh Git inputs'
        printf 'Planning validated freshly. Application gate reused: %s\n' "${reply#HIT }"
        finish ;;
    'MISS '*) printf 'Build cache miss: %s\n' "${reply#MISS }" ;;
    *) incomplete 'Unexpected cache protocol state' ;;
esac
command_from_config build_prepare
if (( ${#command[@]} )); then
    run_phase "${command[@]}"
    tracked=$(tracked_inputs)
    send "$tracked"
fi
receive || finish
log=${reply#GATE }
[[ "$reply" == 'GATE '* && "$log" =~ ^\.runs/build/[0-9TZ-]+[a-f0-9]+/build\.log$ ]] || incomplete 'Unexpected gate protocol state'
command_from_config gate
(( ${#command[@]} )) || incomplete 'No configured gate'
set +e
"${command[@]}" 7>&- 8<&- 2>&1 | tee -- "$log" 7>&- 8<&-
results=("${PIPESTATUS[@]}")
set -e
tracked=null
if (( results[0] == 0 && results[1] == 0 )); then
    tracked=$(tracked_inputs)
fi
result=$(jq -cn --argjson status "${results[0]}" --argjson tracked "$tracked" \
    --argjson log_exit "${results[1]}" '{status:$status,tracked:$tracked,log_exit:$log_exit}')
send "$result"
receive || finish
[[ "$reply" == 'RECEIPT '* ]] || incomplete 'Unexpected receipt protocol state'
printf 'Build receipt: %s\n' "${reply#RECEIPT }"
finish
