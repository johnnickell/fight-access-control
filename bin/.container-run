#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DOCKER_BIN="${DOCKER_BIN:-docker}"
PHP_IMAGE="${FIGHT_ACCESS_CONTROL_PHP_IMAGE:-fight-access-control}"

cd "${ROOT_DIR}"
source "${ROOT_DIR}/bin/.php-runtime"
refresh_php_runtime
exec "${DOCKER_BIN}" container run --rm -it \
    -v "${ROOT_DIR}:/app:delegated" \
    -w /app \
    --user "$(id -u):$(id -g)" \
    "${PHP_IMAGE}" "$@"
